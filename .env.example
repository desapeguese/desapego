# Copie para .env.local e ajuste. Em produção estas são variáveis do Railway.

# Postgres. Local sem Docker: `npm run db:local` e use a URL abaixo.
DATABASE_URL=postgres://postgres@127.0.0.1:5433/postgres
# Só com o banco local (PGlite): uma conexão por vez.
PGPOOL_MAX=1

# Segredo das sessões. Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Endereço público do app, sem barra no fim.
BETTER_AUTH_URL=http://localhost:3000

# E-mails (separados por vírgula) que são Admin desde o primeiro acesso.
ADMIN_EMAILS=

# Resend. Sem a chave, em desenvolvimento, o código de login sai no terminal.
RESEND_API_KEY=
EMAIL_FROM="Moeda Desapego <desapego@festivaldesapeguese.com.br>"

# Login com Google (opcional: sem os dois, o botão não aparece).
# Redirect URI a cadastrar no Google Cloud: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 0 = cadastro fechado: a landing mostra "em breve" e só ADMIN_EMAILS entram.
# Quem já está logado continua logado. Sem a variável, o cadastro está aberto.
CADASTRO_ABERTO=1
