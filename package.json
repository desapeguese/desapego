{
  "name": "desapego",
  "version": "0.1.0",
  "private": true,
  "description": "Moeda Social Desapego — landing page e app da carteira",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/migrar.mjs && next start -p ${PORT:-3000}",
    "lint": "next lint",
    "test": "vitest run",
    "db:local": "node scripts/banco-local.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrar.mjs"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.18",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "jsqr": "^1.4.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "railway": "^3.16.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
